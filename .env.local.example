# worldcup26.ir est une API publique : AUCUNE clé nécessaire.
# (APIFOOTBALL_KEY n'est plus utilisée — tu peux la supprimer de ton .env.local)

# Mode développement hors-ligne : lit data/mock-games.json au lieu de l'API.
# Mettre à 1 pour activer, supprimer (ou 0) pour utiliser l'API réelle.
USE_MOCK=0
